# Copy this file to .env if you want to change the defaults.
APP_PORT=3000
API_PORT=8000

# Local PostgreSQL control-plane database.
POSTGRES_DB=ytupload
POSTGRES_USER=ytupload
POSTGRES_PASSWORD=ytupload-local-dev

# Preferred: put the downloaded Web application client JSON at
# .secrets/google-oauth-client.json. Docker mounts it read-only into the backend.
# These two values remain as a non-Docker fallback and should never be committed.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/automation/oauth/google/callback
# Docker uses the ignored .secrets/oauth-token.key file as independent encryption
# key material. This variable is a non-Docker fallback; never commit a real value.
OAUTH_TOKEN_ENCRYPTION_SECRET=

# FFmpeg encoding quality. Lower CRF means higher quality and larger files.
FFMPEG_CRF=20

# ultrafast, superfast, veryfast, faster, fast, medium, slow, slower
FFMPEG_PRESET=medium

# Optional: auto, h264_nvenc, h264_qsv, or h264_amf. Unsupported hardware falls back to libx264.
FFMPEG_VIDEO_ENCODER=libx264
